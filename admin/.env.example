# Netra admin console — frontend environment template
#
# Copy to .env.local and fill in. .env.local is gitignored and must stay that way.
#
# ─────────────────────────────────────────────────────────────────────────────
# EVERY VITE_ VALUE IS PUBLIC.
#
# Vite compiles these into the JavaScript bundle that every visitor downloads.
# Never place any of the following here, or anywhere under admin/ or frontend/:
#
#   SUPABASE_SECRET_KEY            DATABASE_URL
#   SUPABASE_SERVICE_ROLE_KEY      NETRA_EVIDENCE_KEY
#   DJANGO_SECRET_KEY              NETRA_CUSTODY_SIGNING_PRIVATE_KEY
#   NETRA_SENSOR_SHARED_KEY        NETRA_WEBHOOK_SIGNING_SECRET
#
# Those are backend-only and belong in the Django service's environment.
# See docs/PRODUCTION_ENVIRONMENT_CONTRACT.md.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase — must be the SAME project as the investigator console.
# The admin console administers exactly these users; a separate project would
# manage a separate, empty set of people.
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable-key>

# Django API base. Unused until the backend phase.
VITE_API_BASE_URL=http://localhost:8000/api

# local | staging | production
VITE_DEPLOYMENT_PROFILE=local

# ─────────────────────────────────────────────────────────────────────────────
# Retired names — do not reintroduce.
#
#   VITE_SUPABASE_ANON_KEY        → VITE_SUPABASE_PUBLISHABLE_KEY
#   SUPABASE_SERVICE_ROLE_KEY     → SUPABASE_SECRET_KEY  (backend only;
#                                    its mere presence aborts Django startup)
#   VITE_SUPABASE_REALTIME_ENABLED → removed entirely
# ─────────────────────────────────────────────────────────────────────────────
