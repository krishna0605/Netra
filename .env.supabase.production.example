# Railway shared variables (API and worker). Never copy backend secrets to Vercel.
SUPABASE_PROJECT_REF=replace-with-target-project-ref
SUPABASE_URL=https://replace-with-target-project-ref.supabase.co
# Browser-safe API key used by backend Auth verification requests.
SUPABASE_PUBLISHABLE_KEY=replace-with-target-publishable-key
# Backend-only opaque key. Railway only; never expose this through a VITE_ variable.
SUPABASE_SECRET_KEY=replace-in-backend-secret-manager

# Canonical database variable. Remove SUPABASE_POOLER_DATABASE_URL and
# SUPABASE_DIRECT_DATABASE_URL from Railway after cutover so they cannot conflict.
# Use the target Session Pooler URL and percent-encode the password.
DATABASE_URL=postgresql://postgres.PROJECT_REF:replace-password@replace-session-pooler-host:5432/postgres
DATABASE_CONN_MAX_AGE=0

# Railway/Django deployment posture
DJANGO_DEBUG=0
NETRA_DEPLOYMENT_PROFILE=hackathon-core
NETRA_DEPLOYMENT_ENV=production
NETRA_PUBLIC_API_AUTH_REQUIRED=1
NETRA_DEV_ROLE_HEADERS=0
NETRA_STORAGE_ROOT=/app/storage
NETRA_STORAGE_CACHE_ENABLED=1
NETRA_STORAGE_CACHE_MAX_BYTES=629145600
NETRA_STORAGE_CACHE_MIN_FREE_BYTES=209715200
NETRA_STORAGE_CACHE_STALE_TEMP_SECONDS=3600
NETRA_STORAGE_CACHE_TOUCH_INTERVAL_SECONDS=60
NETRA_STORAGE_CACHE_LOCK_TIMEOUT_SECONDS=30
NETRA_EVIDENCE_WRITE_FORMAT=v2
NETRA_EVIDENCE_ENCRYPTION_CHUNK_BYTES=8388608
NETRA_MAX_INMEMORY_ARTIFACT_BYTES=8388608

# Netra provider selection
NETRA_DATABASE_PROVIDER=supabase
NETRA_DATABASE_MODE=supabase
NETRA_STORAGE_PROVIDER=supabase
# The Railway worker runs run_postgres_worker with PostgreSQL row locking.
# PGMQ is not the active analysis-job provider.
NETRA_QUEUE_PROVIDER=postgres-row-lock
NETRA_AUTH_PROVIDER=supabase
NETRA_AUTH_INVITATIONS_ENABLED=0
NETRA_PASSWORD_RECOVERY_ENABLED=0
# Remain remote through the legacy-token grace window. Switch to
# asymmetric-jwks only after the standby ES256 key is current and verified.
NETRA_SUPABASE_JWT_MODE=remote
NETRA_SUPABASE_JWKS_CACHE_SECONDS=600
NETRA_SUPABASE_JWKS_TIMEOUT_SECONDS=3
NETRA_SUPABASE_JWKS_RESPONSE_MAX_BYTES=131072
NETRA_SUPABASE_JWT_AUDIENCE=authenticated
NETRA_SUPABASE_PRIVILEGED_VERIFY_TIMEOUT_SECONDS=3
# Hosted transport mode remains bearer; Supabase is selected by NETRA_AUTH_PROVIDER.
NETRA_ACCESS_MODE=bearer
NETRA_AUTH_PROXY_ENABLED=0
NETRA_REALTIME_PROVIDER=sse
NETRA_SEARCH_PROVIDER=postgres
NETRA_PROCESSING_MODE=postgres-worker
NETRA_SYNC_FALLBACK_ENABLED=0
NETRA_RELEASE_ID=replace-with-immutable-release-id
NETRA_FREE_PLAN_GUARD=1
NETRA_STORAGE_DEEP_HEALTHCHECK=0
NETRA_DIRECT_UPLOAD_ENABLED=0
NETRA_SUPABASE_START_WORKERS=0
NETRA_ACCESS_LOG_RETENTION_DAYS=365
NETRA_ACCESS_LOG_MAINTENANCE_SECONDS=86400
# Set separately in Railway, never as one shared value:
# API service: NETRA_RUNTIME_ROLE=api
# Worker service: NETRA_RUNTIME_ROLE=worker

# Worker service only. Keep the worker stopped until the bounded activation drill.
NETRA_WORKER_HEARTBEAT_SECONDS=15
NETRA_WORKER_STALE_AFTER_SECONDS=45
NETRA_WORKER_CAPACITY_CACHE_SECONDS=10
NETRA_REQUIRED_TSHARK_VERSION=4.6.7
NETRA_REQUIRED_ZEEK_VERSION=8.2.1

# Railway backend-only abuse controls. Do not copy these to Vercel and do not
# add a VITE_ prefix. Organization queue capacity is stored in Postgres.
NETRA_RATE_LIMITS_ENABLED=1
NETRA_RATE_LIMIT_READ_PER_MINUTE=300
NETRA_RATE_LIMIT_MUTATION_PER_MINUTE=60
NETRA_RATE_LIMIT_UPLOAD_USER_PER_HOUR=10
NETRA_RATE_LIMIT_UPLOAD_ORG_PER_HOUR=25
NETRA_RATE_LIMIT_REPORT_USER_PER_HOUR=10
NETRA_RATE_LIMIT_EXPORT_USER_PER_HOUR=10
NETRA_RATE_LIMIT_WEBHOOK_TEST_ADMIN_PER_HOUR=5
NETRA_RATE_LIMIT_SSE_USER_PER_MINUTE=12
NETRA_RATE_LIMIT_SSE_ORG_PER_MINUTE=60

# Optional integration and import features remain disabled on the Free/Hobby profile until approved.
NETRA_ENABLE_STRUCTURED_IMPORTS=0
NETRA_ENABLE_INTEGRATIONS=0
# Exact comma-separated HTTPS hostnames only. Keep empty while integrations are disabled.
NETRA_WEBHOOK_ALLOWED_HOSTS=
NETRA_WEBHOOK_CONNECT_TIMEOUT_SECONDS=3
NETRA_WEBHOOK_READ_TIMEOUT_SECONDS=5
NETRA_WEBHOOK_REQUEST_MAX_BYTES=262144
NETRA_WEBHOOK_RESPONSE_MAX_BYTES=32768
NETRA_WEBHOOK_MAX_ATTEMPTS=2
NETRA_SSE_MAX_SECONDS=300
NETRA_SSE_HEARTBEAT_SECONDS=15
NETRA_SSE_POLL_SECONDS=5
NETRA_SSE_BATCH_SIZE=100

# Railway API-only deployment URLs and allowed origins
NETRA_PUBLIC_BASE_URL=https://netra-api-production.up.railway.app
NETRA_FRONTEND_ORIGINS=https://netra-hackathon-console-20260714.vercel.app,https://netra-operations-workspace.vercel.app
NETRA_ADMIN_ORIGINS=https://netra-operations-workspace.vercel.app
DJANGO_ALLOWED_HOSTS=netra-api-production.up.railway.app
DJANGO_CSRF_TRUSTED_ORIGINS=https://netra-hackathon-console-20260714.vercel.app,https://netra-operations-workspace.vercel.app

# Supply these only through the deployment secret manager.
DJANGO_SECRET_KEY=replace-in-backend-secret-manager
NETRA_EVIDENCE_KEY=replace-in-backend-secret-manager
NETRA_EVIDENCE_KEY_ID=replace-with-current-key-id
# Optional decrypt-only rollback keys; leave unset for a new deployment.
# Add NETRA_EVIDENCE_PREVIOUS_KEYS through the backend secret manager only when rollback keys exist.
NETRA_CUSTODY_ANCHORS_ENABLED=1
NETRA_CUSTODY_SIGNING_PRIVATE_KEY=replace-with-base64-raw-ed25519-private-key
NETRA_CUSTODY_SIGNING_KEY_ID=replace-with-stable-custody-key-id
NETRA_SENSOR_SHARED_KEY=replace-in-backend-secret-manager

# Vercel Production only. Every VITE_ value is public in the browser bundle.
VITE_API_BASE_URL=https://netra-api-production.up.railway.app/api
VITE_DEPLOYMENT_PROFILE=hackathon-core
VITE_SUPABASE_URL=https://replace-with-target-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=replace-with-target-publishable-key
VITE_DIRECT_UPLOAD_ENABLED=0
VITE_MAX_UPLOAD_MB=25

# Separate Vercel admin project only.
VITE_CONSOLE_URL=https://netra-hackathon-console-20260714.vercel.app
